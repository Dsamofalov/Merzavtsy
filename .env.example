# Merzavtsy daemon configuration
# Copy to .env for local/operator use. Never commit real keys.

# Ethereum JSON-RPC endpoint.
RPC_URL=https://your-rpc.example

# 31337 = local Hardhat/Anvil, 11155111 = Sepolia, 1 = Ethereum mainnet.
CHAIN_ID=11155111

# Must exactly match deployments/<CHAIN_ID>.json and live on-chain wiring.
IDENTITY_ADDRESS=0x0000000000000000000000000000000000000000
WORLD_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# Use two different funded/authorized keys.
# ORACLE_PRIVATE_KEY signs EIP-712 gameplay facts; it should not submit transactions.
ORACLE_PRIVATE_KEY=0x<64-hex-oracle-private-key>
# SUBMITTER_PRIVATE_KEY pays gas and broadcasts attestations/life ticks.
SUBMITTER_PRIVATE_KEY=0x<64-hex-submitter-private-key>

# SQLite state; Docker will normally mount this path from a persistent volume.
DB_PATH=daemon/data/merzavtsy.sqlite

# Operational bounds. Choose a conservative production finality policy.
FINALITY_DEPTH=64
EPOCH_BLOCKS=20
POLL_INTERVAL_MS=15000

# Set true only for local development to enable safe operational defaults.
LOCAL_MODE=false
