{
  "name": "merzavtsy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "hardhat build",
    "compile": "hardhat build",
    "daemon": "node --import tsx daemon/src/main.ts",
    "deploy": "node --import tsx scripts/deploy.ts",
    "status": "node --import tsx scripts/status.ts",
    "birth": "node --import tsx scripts/birth.ts",
    "show:state": "node --import tsx scripts/show-state.ts",
    "show:relationship": "node --import tsx scripts/show-relationship.ts",
    "sign:attestation": "node --import tsx scripts/sign-attestation.ts",
    "submit:attestation": "node --import tsx scripts/submit-attestation.ts",
    "test": "hardhat test",
    "test:contracts": "hardhat test nodejs",
    "test:daemon": "node --import tsx --test daemon/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "verify": "npm run compile && npm run test:contracts && npm run test:daemon && npm run typecheck && npm run audit:high"
  },
  "dependencies": {
    "viem": "2.56.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "hardhat": "3.14.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
